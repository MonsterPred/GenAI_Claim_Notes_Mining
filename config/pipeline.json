{
  "taxonomy_path": "config/taxonomy.json",
  "pseudo_label_path": "data/pseudo_labels.jsonl",
  "output_dir": "outputs",

  "tier1": {
    "backend": "centroid",
    "temperature": 0.10,
    "confidence_threshold": 0.60,
    "margin_threshold": 0.30,
    "pseudo_label_weight": 1.0,
    "ollama": {
      "url": "http://localhost:11434/api/generate",
      "model": "llama3.1:8b",
      "timeout_s": 60
    }
  },

  "distill": {
    "keep_ratio": 0.35,
    "min_keep": 25,
    "bm25_k1": 1.5,
    "bm25_b": 0.75
  },

  "tier2": {
    "enabled": true,
    "backend": "claude_code",
    "claude_code_path": "claude",
    "claude_code_model": null,
    "claude_code_timeout_s": 600,
    "model": "claude-opus-5-5",
    "note_effort": "low",
    "synthesis_effort": "medium",
    "max_notes_per_call": 8,
    "max_tokens_notes": 16000,
    "max_tokens_synthesis": 16000,
    "use_fallbacks": true,
    "pricing_per_mtok": {
      "input": 4.00,
      "output": 20.00,
      "cache_write": 5.00,
      "cache_read": 0.20
    }
  }
}
